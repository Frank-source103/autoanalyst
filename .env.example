# ==============================================================================
# AutoAnalyst Configuration Template
# ==============================================================================

# LLM Provider Configuration ('mock' for testing, or cloud provider e.g. 'openai', 'anthropic', 'gemini')
LLM_PROVIDER=mock
LLM_MODEL=mock-analyst-v1
LLM_API_KEY=

# Budget and Loop Limits
LLM_CALL_BUDGET=30
LLM_TOKEN_BUDGET=100000
MAX_RETRIES_PER_STEP=3
MAX_TOTAL_ITERATIONS=25
MAX_PLAN_STEPS=6
MAX_PAUSE_TTL_SECONDS=1800
ACTIVE_WALL_CLOCK_LIMIT_SECONDS=300

# Sandbox Container Configuration
SANDBOX_IMAGE=autoanalyst-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEM_LIMIT=512m
SANDBOX_PIDS_LIMIT=50

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800
